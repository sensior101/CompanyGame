# Unity regenerates these folders on each developer's machine.
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# IDE-generated files. Keep the shared .vsconfig.
**/.vs/
**/.idea/
*.csproj
*.sln
*.slnx
*.user
*.suo
*.pidb
*.booproj
*.opendb
*.VC.db

# Generated exports and local art-tool caches.
*.unitypackage
**/__pycache__/
*.py[cod]
*.blend[0-9]

# Local configuration. Example environment files may be shared.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Accidentally created nested Unity project
/CompanyGame/CompanyGame/

# Local scratch/export folder (e.g. Notion export), not shared via Git
/_temp/
# Local AI tool folders (Claude Code, Archify output)
/.claude/
/.claude-flow/
/.archify/

# AI agent QA output (captures, validation reports, logs). Regenerated by the QA scripts.
/CompanyGame/Assets/Screenshots/
/CompanyGame/Assets/Screenshots.meta
ArtSource/**/*QA/
ArtSource/**/MotionPreview/
ArtSource/**/*_QA.png
ArtSource/**/*validation*.json
ArtSource/**/*-audit.json
ArtSource/**/*-station.json
ArtSource/**/*runtime*.json
ArtSource/**/transactions.json
ArtSource/**/model-report.json
ArtSource/**/model_stats*.json
ArtSource/**/*delivery.json
ArtSource/**/before.json
ArtSource/**/play-tour.json
ArtSource/**/*.log
