# Unity regenerates these folders on each developer's machine.
**/[Ll]ibrary/
# Authored furniture assets are not Unity's generated project Library cache.
!/CompanyGame/Assets/Art/Items/Furniture/Library/
!/CompanyGame/Assets/Art/Items/Furniture/Library/**
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# IDE-generated files. Keep the shared .vsconfig.
**/.vs/
**/.idea/
*.csproj
*.sln
*.slnx
*.user
*.suo
*.pidb
*.booproj
*.opendb
*.VC.db

# Generated exports and local art-tool caches.
*.unitypackage
**/__pycache__/
*.py[cod]
*.blend[0-9]

# Local configuration. Example environment files may be shared.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Accidentally created nested Unity project
/CompanyGame/CompanyGame/

# Local scratch/export folder (e.g. Notion export), not shared via Git
/_temp/
# Local AI tool folders (Claude Code, Archify output)
/.claude/
.claude-flow/
/.archify/

# AI agent QA output (captures, validation reports, logs). Regenerated by the QA scripts.
/CompanyGame/Assets/Screenshots/
/CompanyGame/Assets/Screenshots.meta
ArtSource/**/*QA/
ArtSource/**/MotionPreview/
ArtSource/**/*_QA.png
ArtSource/**/*validation*.json
ArtSource/**/*-audit.json
ArtSource/**/*-station.json
ArtSource/**/*runtime*.json
ArtSource/**/transactions.json
ArtSource/**/model-report.json
ArtSource/**/model_stats*.json
ArtSource/**/*delivery.json
ArtSource/**/before.json
ArtSource/**/play-tour.json
ArtSource/**/*.log

# Regenerable architecture review images, reports and Blender GPU cache.
/optix7cache.db*
ArtSource/**/BlockoutRenders/
ArtSource/**/Validation/*.json
ArtSource/**/build_result.json
ArtSource/**/comparison_result.json
/ArtSource/WorldDistricts/CompanyBuildings/OfficeSet_ABCD/Comparison.blend
/ArtSource/WorldDistricts/CompanyBuildings/OfficeSet_ABCD/Comparison_ABCD.png
/ArtSource/Items/Vehicles/CityBicycle/Preview.png

# Heavy art sources (Blender/model files, archives, renders, video) are kept outside Git; see ArtSource/README.md.
# Build scripts, READMEs and small json stay in Git. Files committed before this rule stay tracked.
ArtSource/**/*.[bB][lL][eE][nN][dD]
ArtSource/**/*.[bB][lL][eE][nN][dD][0-9]
ArtSource/**/*.[fF][bB][xX]
ArtSource/**/*.[gG][lL][bB]
ArtSource/**/*.[gG][lL][tT][fF]
ArtSource/**/*.[oO][bB][jJ]
ArtSource/**/*.[zZ][iI][pP]
ArtSource/**/*.[pP][nN][gG]
ArtSource/**/*.[jJ][pP][gG]
ArtSource/**/*.[jJ][pP][eE][gG]
ArtSource/**/*.[wW][eE][bB][pP]
ArtSource/**/*.[gG][iI][fF]
ArtSource/**/*.[mM][pP]4
ArtSource/**/*.[eE][xX][rR]
ArtSource/**/*.[pP][sS][dD]
ArtSource/**/*.[tT][gG][aA]
ArtSource/**/*.[bB][iI][nN]

# AI work records next to art sources: pre-edit code copies, scene backups, validation output, review pages,
# hash/evidence files and superseded script versions. They stay on disk; files committed before this rule stay tracked.
ArtSource/**/Baseline/
ArtSource/**/Before/
ArtSource/**/_History/
ArtSource/**/History/
ArtSource/**/Review/
ArtSource/**/UnityIntegration/
ArtSource/**/CookingIntegration/
ArtSource/**/CharacterScaleAudit_*/
ArtSource/**/*[hH]ashes.json
ArtSource/**/*sha256*
ArtSource/**/*[eE]vidence.json
ArtSource/**/*summary.json
ArtSource/**/restore_*.json
ArtSource/**/export_report.json
ArtSource/**/preview_manifest.json
ArtSource/**/RoundTripReport*.json

# EOS credentials (local only)
CompanyGame/eos.local.json
# EOS plugin config made from eos.local.json by EosTestQA.WriteConfig (holds the client secret)
/CompanyGame/Assets/StreamingAssets/EOS/
/CompanyGame/Assets/StreamingAssets/EOS.meta

# Cloudflare wrangler local cache, Unity scene crash-recovery copies
/.wrangler/
/CompanyGame/Assets/_Recovery/
/CompanyGame/Assets/_Recovery.meta
