# Normalize text in Git; keep binary formats unchanged.
* text=auto

*.cs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Unity references and scenes remain readable and diffable in regular Git.
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text=auto eol=lf
*.asset text=auto eol=lf

# Small documentation images stay in regular Git.
*.png binary
*.jpg binary
*.jpeg binary

# Large, non-mergeable model sources use Git LFS.
*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
*.[gG][lL][bB] filter=lfs diff=lfs merge=lfs -text
*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
